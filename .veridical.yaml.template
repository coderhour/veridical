# ------------------------------------------------------------------------------
# Report Configuration
# ------------------------------------------------------------------------------
report:
  # Default output format for `veri report`
  # Available values: terminal, json, html
  default_format: terminal

  # Optional: Path to custom Jinja2 template for HTML reports
  # html_template: templates/report.html.j2

  # Optional: Local LLM for advanced log analysis (e.g., Ollama)
  # local_llm:
  #   base_url: http://localhost:11434/v1
  #   model: qwen2.5:7b
  #   api_key: ollama  # optional, use "ollama" for Ollama
  #   timeout: 30
  #   chunk_size: 500

# ------------------------------------------------------------------------------
# Local Loop Configuration
# ------------------------------------------------------------------------------
# local:
  # Named provider preset (auto-configures command, mode, and error delivery)
  # Available providers: claude-code, gemini-cli
  # Run `veri local --list-providers` to see all providers and detection status
  # provider: claude-code

  # Or specify a custom worker command directly (overrides provider default)
  # worker_command: "claude --print --output-format text -p"

  # Execution mode: subprocess (captures output) or interactive (TTY-attached)
  # mode: subprocess

  # Timeout in seconds for the worker execution
  # worker_timeout: 600

  # Environment variable to pass error context to the worker
  # error_env_var: VERIDICAL_ERROR_CONTEXT

  # Enable gtr (Git Worktree Runner) for isolated parallel worktrees
  # When true, each `veri local` run creates a separate worktree on an
  # auto-generated branch (e.g. veri/add-user-auth).
  # Requires gtr: https://github.com/coderabbitai/git-worktree-runner
  # Can also be enabled per-run with `veri local --gtr`
  # gtr_enabled: false

  # Automatically remove the gtr worktree after a successful merge
  # On failure or merge conflict the worktree is always preserved
  # gtr_auto_cleanup: true

# ------------------------------------------------------------------------------
# Git Configuration
# ------------------------------------------------------------------------------
git:
  # Base branch to create iteration branches from
  base_branch: main

  # Prefix for iteration branch names
  branch_prefix: veridical/iter-

  # Automatically delete iteration branches after successful merge
  auto_cleanup: true

  # Automatically create a work branch for changes instead of merging to base_branch
  # When true, creates a feature branch like "feat/task-description"
  # When false, merges directly to base_branch (legacy behavior)
  auto_create_work_branch: true

  # Scope validation for incoming patches (security)
  scope_validation:
    # Files explicitly allowed to be modified (glob patterns)
    # If set, ONLY matching files can be modified (allowlist mode)
    # allowlist:
    #   - "src/**/*.py"
    #   - "tests/**/*.py"

    # Files that are NEVER allowed to be modified (rejected outright)
    # Default includes: CI/CD configs, secrets, infrastructure, AI agent files
    # denylist:
    #   - ".github/"
    #   - "*.env"
    #   - "*.pem"
    #   - "AGENTS.md"

    # Files that require explicit human approval before applying
    # Default includes package lock files for supply chain security
    # reviewlist:
    #   - "package-lock.json"
    #   - "poetry.lock"
    #   - "yarn.lock"

    # If true (default), patches violating scope are rejected
    # If false, violations are logged as warnings but patch proceeds
    strict_mode: true
